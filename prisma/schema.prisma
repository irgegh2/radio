generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Track {
  id            Int      @id @default(autoincrement())
  title         String
  artist        String
  genre         String?
  coverUrl      String?
  coverKey      String?
  audioUrl      String
  s3Key         String?
  duration      Int?
  kind          String   @default("MUSIC")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  plays         Play[]
  playlistItems PlaylistTrack[]
  queueItems    QueueOverride[]
}

model Playlist {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  active      Boolean  @default(true)
  shuffle     Boolean  @default(true)
  createdAt   DateTime @default(now())
  items       PlaylistTrack[]
  schedules   ScheduleBlock[]
}

model PlaylistTrack {
  id         Int      @id @default(autoincrement())
  playlistId Int
  trackId    Int
  position   Int      @default(0)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
}

model ScheduleBlock {
  id          Int      @id @default(autoincrement())
  title       String
  dayOfWeek   Int
  startSecond Int
  endSecond   Int
  active      Boolean  @default(true)
  playlistId  Int
  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Show {
  id          Int      @id @default(autoincrement())
  title       String
  host        String
  description String?
  imageUrl    String?
  startHour   Int
  endHour     Int
  dayOfWeek   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Play {
  id        Int      @id @default(autoincrement())
  trackId   Int
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())
  endedAt   DateTime?
}

model QueueOverride {
  id          Int      @id @default(autoincrement())
  trackId     Int
  position    Int      @default(0)
  scheduledAt DateTime
  createdAt   DateTime @default(now())
  track       Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model BroadcastControl {
  id                  Int      @id @default(1)
  mode                String   @default("AUTO")
  status              String   @default("PLAYING")
  manualTrackId       Int?
  manualPlaylistId    Int?
  manualStartedAt     DateTime?
  manualOffsetSeconds Int      @default(0)
  version             Int      @default(0)
  updatedAt           DateTime @updatedAt
}

model StationSettings {
  id                Int      @id @default(1)
  stationName       String   @default("NEXUS RADIO")
  tagline           String   @default("Больше, чем просто музыка")
  streamUrl         String?
  isLive            Boolean  @default(true)
  volume            Int      @default(72)
  timezone          String   @default("Europe/Moscow")
  rotationStartedAt DateTime @default(now())
  defaultPlaylistId Int?
  repeatWindow      Int      @default(50)
}
